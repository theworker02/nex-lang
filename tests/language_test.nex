// Core language tests for `nex test`

assert_eq(1 + 2, 3, "integer add");
assert_eq(len("nex"), 3, "string len");
assert_eq([1, 2, 3][1], 2, "array index");

let add = fn(a, b) { return a + b; };
assert_eq(add(10, 32), 42, "function call");

struct Point { x, y };
let p = Point(3, 4);
assert_eq(p.x + p.y, 7, "struct fields");

let classified = match (4) {
  0 -> 0,
  1 -> 1,
  _ -> 16
};
assert_eq(classified, 16, "match wildcard");

let doubled = fn(n) {
  if (n > 0) {
    return ok(n * 2);
  };
  return err("non-positive");
};
assert(is_ok(doubled(21)), "result ok");
assert_eq(unwrap(doubled(21)), 42, "unwrap ok");
assert(is_err(doubled(0)), "result err");

assert_eq([1, 2, 3] |> map(fn(x) { x + 1 }), [2, 3, 4], "pipe map");

puts("language_test ok");
true
